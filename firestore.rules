rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidSiteCredits(data) {
      return data.keys().hasAll(['creatorName', 'infoSources'])
        && data.keys().hasOnly(['creatorName', 'infoSources', 'updatedAt'])
        && data.creatorName is string
        && data.creatorName.size() >= 1
        && data.creatorName.size() <= 100
        && data.infoSources is list
        && data.infoSources.size() <= 10
        && (data.infoSources.size() == 0 || data.infoSources[0] is string)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidEvaluation(data) {
      return data.keys().hasAll(['score', 'feedback'])
        && data.keys().hasOnly(['score', 'feedback', 'teacherName', 'createdAt'])
        && data.score is string
        && data.score.size() >= 1
        && data.score.size() <= 10
        && data.feedback is string
        && data.feedback.size() >= 1
        && data.feedback.size() <= 1000
        && (!('teacherName' in data) || (data.teacherName is string && data.teacherName.size() <= 100))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    // Connection testing
    match /test/{docId} {
      allow read: if isValidId(docId);
    }

    // Real-time editable credits and site information
    match /site_meta/{metaId} {
      allow get, list: if isValidId(metaId);
      allow create, update: if isValidId(metaId) && isValidSiteCredits(incoming());
      allow delete: if false;
    }

    // Teacher evaluations and feedback
    match /evaluations/{evaluationId} {
      allow get, list: if isValidId(evaluationId);
      allow create: if isValidId(evaluationId) && isValidEvaluation(incoming());
      allow update, delete: if false;
    }
  }
}
